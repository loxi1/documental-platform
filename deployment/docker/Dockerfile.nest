# Node 22.23.4; immutable locally verified base identity.
FROM node@sha256:fe4f6d74e20370acb04ad889077d14d0f64a9c8ea6a42bc60cddf1e844699914 AS base
WORKDIR /app
ENV COREPACK_DEFAULT_TO_LATEST=0
RUN corepack enable && corepack prepare pnpm@11.4.0 --activate

FROM base AS deps
COPY package.json pnpm-lock.yaml pnpm-workspace.yaml ./
COPY apps ./apps
COPY packages ./packages
RUN pnpm install --frozen-lockfile --dangerously-allow-all-builds

FROM deps AS build
ARG APP_PATH
ARG APP_PACKAGE
WORKDIR /app
RUN test -n "${APP_PATH}"
RUN test -n "${APP_PACKAGE}"
RUN pnpm --filter "@documental/shared" run build  && pnpm --filter "@documental/config" run build  && pnpm --filter "@documental/database" run build  && pnpm --filter "${APP_PACKAGE}" run build

# Node 22.23.4; immutable locally verified base identity.
FROM node@sha256:fe4f6d74e20370acb04ad889077d14d0f64a9c8ea6a42bc60cddf1e844699914 AS runner
WORKDIR /app
ENV NODE_ENV=production
ENV COREPACK_DEFAULT_TO_LATEST=0
RUN corepack enable && corepack prepare pnpm@11.4.0 --activate

COPY --from=deps /app ./

ARG APP_PATH
COPY --from=build /app/${APP_PATH}/dist /app/${APP_PATH}/dist
COPY --from=build /app/packages/shared/dist /app/packages/shared/dist
COPY --from=build /app/packages/config/dist /app/packages/config/dist
COPY --from=build /app/packages/database/dist /app/packages/database/dist

WORKDIR /app/${APP_PATH}

CMD ["node", "dist/main.js"]