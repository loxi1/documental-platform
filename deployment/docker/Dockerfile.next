# Node 22.23.4; immutable locally verified base identity.
FROM node@sha256:fe4f6d74e20370acb04ad889077d14d0f64a9c8ea6a42bc60cddf1e844699914 AS base
WORKDIR /app
ENV COREPACK_DEFAULT_TO_LATEST=0
RUN corepack enable && corepack prepare pnpm@11.4.0 --activate

FROM base AS deps
COPY package.json pnpm-lock.yaml pnpm-workspace.yaml ./
COPY apps ./apps
COPY packages ./packages
RUN pnpm install --frozen-lockfile --dangerously-allow-all-builds

FROM deps AS build
ARG APP_PATH
ARG NEXT_PUBLIC_APP_URL
ARG NEXT_PUBLIC_API_URL
ARG NEXT_PUBLIC_AUTH_API_URL
ARG NEXT_PUBLIC_APP_NAME
ARG NEXT_PUBLIC_ALLOW_LOCAL_API_FOR_TESTS

ENV NEXT_PUBLIC_APP_URL=${NEXT_PUBLIC_APP_URL}
ENV NEXT_PUBLIC_API_URL=${NEXT_PUBLIC_API_URL}
ENV NEXT_PUBLIC_AUTH_API_URL=${NEXT_PUBLIC_AUTH_API_URL}
ENV NEXT_PUBLIC_APP_NAME=${NEXT_PUBLIC_APP_NAME}
ENV NEXT_PUBLIC_ALLOW_LOCAL_API_FOR_TESTS=${NEXT_PUBLIC_ALLOW_LOCAL_API_FOR_TESTS}
ENV NODE_ENV=production

WORKDIR /app/${APP_PATH}
RUN pnpm build

# Node 22.23.4; immutable locally verified base identity.
FROM node@sha256:fe4f6d74e20370acb04ad889077d14d0f64a9c8ea6a42bc60cddf1e844699914 AS runner
ARG APP_PATH
WORKDIR /app/${APP_PATH}
ENV NODE_ENV=production
ENV PORT=3005
ENV HOSTNAME=0.0.0.0

COPY --from=deps /app/node_modules /app/node_modules
COPY --from=deps /app/packages /app/packages
COPY --from=deps /app/${APP_PATH}/node_modules ./node_modules
COPY --from=deps /app/${APP_PATH}/package.json ./package.json
COPY --from=deps /app/${APP_PATH}/next.config.* ./
COPY --from=deps /app/${APP_PATH}/public ./public
COPY --from=deps /app/${APP_PATH}/src ./src
COPY --from=build /app/${APP_PATH}/.next ./.next

EXPOSE 3005
CMD ["node", "./node_modules/next/dist/bin/next", "start", "--port", "3005", "--hostname", "0.0.0.0"]